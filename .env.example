# --- IA (Vercel AI Gateway) ---
# Crea la key en https://vercel.com/ai-gateway (API Keys)
AI_GATEWAY_API_KEY=
# Modelo verificado y disponible en AI Gateway (no cambiar sin verificar antes)
AI_MODEL=anthropic/claude-sonnet-5

# --- Persistencia ---
# Si se deja vacío, la app usa un store en memoria (solo para desarrollo local).
# Para producción: cadena de conexión de Postgres (por ejemplo, Neon).
DATABASE_URL=

# --- WhatsApp (deep link, sin integración oficial todavía) ---
NEXT_PUBLIC_WHATSAPP_NUMBER=573167824217

# --- Sitio ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
